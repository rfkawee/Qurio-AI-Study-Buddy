# ==============================================================================
# QURIO ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AI LLM Provider: OpenRouter API
# ------------------------------------------------------------------------------
# OpenRouter API Key (Dapatkan di https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# 2. Database Connection (PostgreSQL + pgvector / SQLite)
# ------------------------------------------------------------------------------
# Opsi A (Produksi - Supabase PostgreSQL + pgvector):
# Dapatkan di: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Contoh (Session pooler port 5432):
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Opsi B (Produksi - Self-Hosted Docker Compose):
# DATABASE_URL=postgresql://qurio_admin:qurio_secret_password@db:5432/qurio

# Opsi C (Lokal Development - SQLite Fallback):
DATABASE_URL=sqlite:///./qurio.db

# 3. Supabase Authentication (Opsional, untuk login multi-user)
# ------------------------------------------------------------------------------
# Dapatkan di: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# Untuk Frontend React (Vite membaca prefix VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# 4. App Limits & File Storage (Maksimal 5 MB per file, tanpa batasan halaman)
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# 5. Environment Mode ('development' atau 'production')
# ------------------------------------------------------------------------------
APP_ENV=development
