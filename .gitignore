# ==============================================================================
# QURIO - REPOSITORY GITIGNORE CONFIGURATION
# ==============================================================================

# 1. Environment secrets & sensitive keys
.env
.env.*
!.env.example
*.env.local

# 2. Local databases & runtime state
*.db
*.db-journal
*.sqlite
*.sqlite3
qurio.db
konco_sinauku.db

# 3. User document uploads (persist directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep

# 4. Python bytecode, virtual environments & test caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
env/
venv/
ENV/
build/
dist-py/

# 5. Frontend & Node dependencies & build artifacts
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# 6. Local AI Agent logs & skills cache
.agents/
*.log
logs/

# 7. Non-development documents & historical backups (kept on local disk only)
legacy_backup/
*.docx

# 8. OS and IDE specific files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
